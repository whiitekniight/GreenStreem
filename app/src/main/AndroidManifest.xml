<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".GreenStreemApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GreenStreem">

        <service android:name=".RecordingService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".RecordingShareService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <activity android:name=".SharedRecordingsActivity" android:exported="false" android:screenOrientation="landscape" android:theme="@style/Theme.GreenStreem.NoActionBar" />
        <receiver android:name=".RecordingAlarm" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:name=".RecordingsActivity" android:exported="false" android:screenOrientation="landscape" android:theme="@style/Theme.GreenStreem.NoActionBar" />
        <activity android:name=".MaintenanceActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".XtreamLoginActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".M3uLoginActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />



        <activity
            android:name=".PlaylistSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".PlaylistManagerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".TvSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".PlaybackSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".DownloadSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".AdvancedSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />
        <activity
            android:name=".BackupRestoreActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".PlaylistProfileSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".ChannelSortingModeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />
        <activity
            android:name=".ManualChannelSortingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".ManageGroupsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".GroupSortingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SeriesDetailsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar" />

        <activity
            android:name=".EpgActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GreenStreem.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".CloudBackupAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".CloudBackupScheduleRefreshReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

